constraints         = none
integrator          = steep
nsteps              = 100000

; Energy minimization
emtol               = 100.0
emstep              = 0.01

; Neighbor searching and periodic box
cutoff-scheme       = Verlet
pbc                 = xyz
rlist               = 1.0

; Electrostatics
coulombtype         = PME
rcoulomb            = 1.0

; Van der Waals
vdwtype             = Cut-off
rvdw                = 1.0
DispCorr            = EnerPres

; No temperature, pressure, or velocity generation during minimization
tcoupl              = no
pcoupl              = no
gen_vel             = no