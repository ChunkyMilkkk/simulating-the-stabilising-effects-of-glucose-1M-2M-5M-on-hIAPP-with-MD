constraints         =  none
integrator          =  steep
nsteps              =  100000
;
;	Energy minimizing stuff
;
emtol               =  100
emstep              =  0.01

cutoff-scheme       =  Verlet
coulombtype         =  pme
rlist               =  1.0
rcoulomb            =  1.0
rvdw                =  1.0
Tcoupl              =  no
Pcoupl              =  no
gen_vel             =  no
